@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h1>Family Recipes</h1>

@if (Model.Recipes.Count == 0)
{
    <p>No recipes yet. <a asp-page="/Create">Create the first one!</a></p>
}
else
{
    <section>
        @foreach (var recipe in Model.Recipes)
        {
            <partial name="_PostCard" model="recipe" />
        }
    </section>
}
