@page
@model FamilyRecipes.Pages.CreateModel
@{
    ViewData["Title"] = "New Recipe";
}

<h1>New Recipe</h1>

<form method="post">
    <div class="form-row">
        <label asp-for="Form.Name"></label>
        <input asp-for="Form.Name" />
        <span class="validation" asp-validation-for="Form.Name"></span>
    </div>

    <div class="form-row">
        <label asp-for="Form.Ingredients"></label>
        <p>Enter one ingredient per line.</p>
        <textarea asp-for="Form.Ingredients" rows="8"></textarea>
        <span class="validation" asp-validation-for="Form.Ingredients"></span>
    </div>

    <div class="form-row">
        <label asp-for="Form.Instructions"></label>
        <textarea asp-for="Form.Instructions" rows="8"></textarea>
        <span class="validation" asp-validation-for="Form.Instructions"></span>
    </div>

    <button type="submit">Save Recipe</button>
</form>