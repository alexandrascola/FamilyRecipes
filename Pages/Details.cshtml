@page "{id:int}"
@model FamilyRecipes.Pages.DetailsModel
@using Microsoft.Extensions.Options
@using FamilyRecipes.Options
@inject IOptions<SiteOptions> Site
@{
    ViewData["Title"] = Model.Recipe?.Name ?? "Recipe";   
}

@if (Model.Recipe is null)
{
    <p>Recipe Not Found.</p>
}
else
{
    <article class="post">
        <h1>@Model.Recipe.Name</h1>
        <p class="meta">@Model.Recipe.CreatedUtc.ToLocalTime()</p>
        
        <h2>Ingredients</h2>
        <div>
            @Model.Recipe.Ingredients
        </div>

        <h2>Instructions</h2>
        <div>
            @Model.Recipe.Instructions
        </div>

        <p><a asp-page="/Index">Back to List</a></p>
    </article>
    @if (Site.Value.EnableComments)
{
    <section class="comments">
        <h2>Leave a comment</h2>
        <form method="post">
            <div class="form-row">
                <label for="comment">Comment</label>
                <textarea id="comment" name="comment" rows="4"></textarea>
            </div>
            <button type="submit" disabled>Post</button>
            <p class="meta">Comments are enabled but will not be saved.</p>
        </form>
    </section>
}
else
{
    <p class="meta">Comments are disabled by configuration.</p>
}
}