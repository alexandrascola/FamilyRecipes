@model FamilyRecipes.Models.Recipe
<article class="post-card">
    <header class="post-card__header">
        <h2 class="post-card__title">
            <a asp-page="/Details" asp-route-id="@Model.Id">@Model.Name</a>
        </h2>
        <small class="post-card__date">@Model.CreatedUtc.ToLocalTime()</small>
        </header>

        <p class="post-card__excerpt">
            @(Model.Instructions.Length > 160 ? Model.Instructions.Substring(0, 160) + "..." : Model.Instructions)
        </p>
        <a class="post-card__more" asp-page="/Details" asp-route-id="@Model.Id">ReadMore</a>
        <hr />


</article>