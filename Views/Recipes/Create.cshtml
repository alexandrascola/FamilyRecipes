@model FamilyRecipes.Models.Recipe

@{
    ViewData["Title"] = "New Recipe";
}

<h1>New Recipe</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Ingredients"></label>
        <p>Enter one ingredient per line.</p>
        <textarea asp-for="Ingredients" rows="8"></textarea>
        <span asp-validation-for="Ingredients"></span>
    </div>

    <div>
        <label asp-for="Instructions"></label>
        <textarea asp-for="Instructions" rows="8"></textarea>
        <span asp-validation-for="Instructions"></span>
    </div>

    <div>
        <label for="image">Recipe image (optional)</label>
        <p>Choose a .jpg or .png file under 2 MB.</p>
        <input type="file" id="image" name="image" accept=".jpg,.png" />
        @Html.ValidationMessage("image") @* Displays image upload errors *@
    </div>

    <button type="submit">Save Recipe</button>
</form>

<p><a asp-action="Index">Back to Recipes List</a></p>