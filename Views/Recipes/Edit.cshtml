@model FamilyRecipes.Models.Recipe

@{
    ViewData["Title"] = "Edit Recipe";
}

<h1 class="recipe-form-title">Edit Recipe</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="recipe-form">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Ingredients"></label>
        <p class="ingredient-hint">Enter one ingredient per line.</p>
        <textarea asp-for="Ingredients" rows="5"></textarea>
        <span asp-validation-for="Ingredients"></span>
    </div>

    <div>
        <label asp-for="Instructions"></label>
        <textarea asp-for="Instructions" rows="5"></textarea>
        <span asp-validation-for="Instructions"></span>
    </div>

    <div>
        <label for="image">Recipe image (optional)</label>
        <p>Choose a .jpg or .png file under 2 MB. Leave blank to keep the current image.</p>
        <input type="file" id="image" name="image" accept=".jpg,.png" />
        @Html.ValidationMessage("image")
        @* Displays image upload errors *@
    </div>

    <button type="submit">Save Changes</button>
</form>

<p><a asp-action="Index">Back to Recipes List</a></p>